# Depo kökündeki .env'e konacak değişken adları (değerler git'e girmez). Compose bu dosyayı hem
# konteyner ortamı hem bind mount yolları (DATA_DIR, MODELS_DIR) için okur.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DATA_DIR=
MODELS_DIR=
TMDB_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Toplu yüklemede HNSW indeksini düşürmek için eklenecek en az satır sayısı (varsayılan 20000).
DJANGO_FILMS_BULK_INDEX_THRESHOLD=20000
# İndeks yeniden kurulurken oturuma verilen bellek; db shm_size değerinden küçük olmalı (varsayılan 1GB).
DJANGO_FILMS_INDEX_MAINTENANCE_WORK_MEM=1GB

# Herkese açık film sitesi (reelsift-vitrin): adres (http:// ya da https:// ile) ve bu kuruluma verilen anahtar.
# İkisi de doluysa onaylı seçkide "Sitede yayınla" düğmesi çıkar; boşsa yalnız paylaşım linki kullanılır.
VITRIN_URL=
VITRIN_API_KEY=

ANTHROPIC_MODEL=
# Dil modeli sağlayıcısı: anthropic (varsayılan), gemini (Google AI Studio, ücretsiz GEMINI_API_KEY)
# ya da ollama (bu makinede çalışan yerel model, anahtar gerekmez).
LLM_PROVIDER=
# Gemini modeli (boşsa gemini-3.5-flash-lite); yalnız LLM_PROVIDER=gemini iken kullanılır.
GEMINI_MODEL=
# Gemini için dakikada en çok çağrı (boşsa 8); ücretsiz kotayı aşmamak için çağrılar bu hızla yayılır.
GEMINI_RPM=
# Gemini yedek modelleri (virgüllü liste, boş = yedek yok); birincil model 503'lerle tükenirse ya da günlük kotası dolarsa sırayla denenir.
GEMINI_FALLBACK_MODELS=
# 1 ise sunucu açılışında arama modelleri arka planda ısıtılır (varsayılan kapalı; compose'ta açık).
SEARCH_WARMUP=
# Yerel model (LLM_PROVIDER=ollama): Ollama adresi (boşsa http://host.docker.internal:11434, konteynerden host'a).
OLLAMA_BASE_URL=
# Ollama modeli (boşsa qwen3:4b-instruct-2507-q4_K_M); önce `ollama pull` ile indirilmiş olmalı.
OLLAMA_MODEL=
# Ollama bağlam penceresi, token (boşsa 12288); büyüdükçe ekran kartı belleği artar.
OLLAMA_NUM_CTX=
